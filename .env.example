PORT=5174
HOST=127.0.0.1
JUDGE_JURY_DB_PATH=data/judge-jury.sqlite
EVIDENCE_STORAGE_DIR=data/evidence
CORPUS_STORAGE_DIR=data/corpus/blobs
CORPUS_PREVIEW_DIR=uploads/corpus-previews
UPLOAD_TMP_DIR=uploads/tmp
JUDGE_JURY_MAX_UPLOAD_BYTES=262144000
JUDGE_JURY_MAX_ARCHIVE_BYTES=367001600
JUDGE_JURY_MAX_ZIP_BYTES=2147483648
JUDGE_JURY_MAX_ZIP_EXPANDED_BYTES=4294967296
JUDGE_JURY_MAX_ZIP_RATIO=200
JUDGE_JURY_MAX_CORPUS_FILES=20000
JUDGE_JURY_MAX_EXTRACTED_CHARACTERS=5000000

# The default loopback host needs no authentication. For any non-loopback HOST,
# both a 24+ character bearer token and explicit comma-separated origins are required.
#LOCAL_API_TOKEN=
#ALLOWED_ORIGINS=https://judge-jury.example.test
API_RATE_LIMIT_PER_MINUTE=240

# Local/OpenAI-compatible runtime, for example Ollama.
MODEL_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=qwen2.5:14b
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
# Output token budget per model call (secret ballots are capped lower automatically).
# Defaults to 6000 for local runtimes and 16000 for external providers such as
# MiniMax, whose reasoning tokens share the budget.
#MODEL_MAX_OUTPUT_TOKENS=6000
# Optional: force one sampling temperature for every stage. Leave unset to use
# the per-stage defaults (jury 0.7, advocates 0.5, analyst/charge/judge 0.2).
#MODEL_TEMPERATURE=

# Optional external MiniMax runtime. Set MODEL_PROVIDER=minimax and provide a key.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Optional local media extraction overrides. ffprobe/FFmpeg and Whisper are
# preflighted at extraction time; unavailable tools produce needs_review state.
#FFPROBE_PATH=ffprobe
#WHISPER_PATH=whisper
WHISPER_MODEL=base
JUDGE_JURY_WHISPER_TIMEOUT_MS=1800000

# Local structured JSONL logs. Set LOG_ENABLED=0 to disable.
LOG_DIR=logs
LOG_LEVEL=debug
LOG_ENABLED=1

# Reverse-proxy / remote-binding options. TRUST_PROXY is passed to Express
# "trust proxy" ("true", a hop count such as "1", or "loopback"). Rate limiting
# applies when HOST is non-loopback, or whenever API_RATE_LIMIT_PER_MINUTE is set.
#TRUST_PROXY=1
#API_RATE_LIMIT_PER_MINUTE=240

# Corpus preview hashes ZIP entries up to this size in memory; larger entries are
# hashed during import instead.
#JUDGE_JURY_MAX_PREVIEW_HASH_BYTES=67108864
