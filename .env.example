PORT=5174
HOST=127.0.0.1
JUDGE_JURY_DB_PATH=data/judge-jury.sqlite
EVIDENCE_STORAGE_DIR=data/evidence
UPLOAD_TMP_DIR=uploads/tmp
JUDGE_JURY_MAX_UPLOAD_BYTES=262144000
JUDGE_JURY_MAX_ARCHIVE_BYTES=367001600

# The default loopback host needs no authentication. For any non-loopback HOST,
# both a 24+ character bearer token and explicit comma-separated origins are required.
#LOCAL_API_TOKEN=
#ALLOWED_ORIGINS=https://judge-jury.example.test
API_RATE_LIMIT_PER_MINUTE=240

# Local/OpenAI-compatible runtime, for example Ollama.
MODEL_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=qwen2.5:14b
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
# Output token budget per model call (secret ballots are capped lower automatically).
MODEL_MAX_OUTPUT_TOKENS=6000
# Optional: force one sampling temperature for every stage. Leave unset to use
# the per-stage defaults (jury 0.7, advocates 0.5, analyst/charge/judge 0.2).
#MODEL_TEMPERATURE=

# Optional external MiniMax runtime. Set MODEL_PROVIDER=minimax and provide a key.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Local structured JSONL logs. Set LOG_ENABLED=0 to disable.
LOG_DIR=logs
LOG_LEVEL=debug
LOG_ENABLED=1
